    <decisions>
        <name>Moderator_Present</name>
        <label>Moderator present?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Moderator will see the task</defaultConnectorLabel>
        <rules>
            <name>No_Moderator</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Active_Moderator.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
